TAG=local

# REQUIRED — set these to your production domain before deploying
# Example: https://crm.askexe.com (no trailing slash)
SERVER_URL=https://crm.askexe.com
FRONTEND_URL=https://crm.askexe.com

# REQUIRED — generate with: openssl rand -base64 48
# Must be at least 32 characters. DO NOT use the default in production.
APP_SECRET=REPLACE_ME_generate_with_openssl_rand_base64_48

# REQUIRED — database password
PG_DATABASE_PASSWORD=REPLACE_ME_generate_with_openssl_rand_base64_32

# REQUIRED — purchase at https://askexe.com
EXE_LICENSE_KEY=REPLACE_ME_with_your_license_key

STORAGE_TYPE=local

# Optional: GoTrue SSO integration
# GOTRUE_URL=
# GOTRUE_JWT_ISSUER=
# GOTRUE_JWT_AUDIENCE=

# Optional: Google OAuth (uncomment and set to enable)
# AUTH_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=https://crm.askexe.com/auth/google/redirect
# AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.askexe.com/auth/google-apis/get-access-token

# Optional: Microsoft OAuth (uncomment and set to enable)
# AUTH_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_CALLBACK_URL=https://crm.askexe.com/auth/microsoft/redirect
# AUTH_MICROSOFT_APIS_CALLBACK_URL=https://crm.askexe.com/auth/microsoft-apis/get-access-token
