CRM_IMAGE_TAG=v0.9.51

#PG_DATABASE_USER=postgres
#PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_url_encoded_if_needed
#PG_DATABASE_HOST=db
#PG_DATABASE_PORT=5432
#PG_DATABASE_NAME=default
# Or point directly at exe-db / another shared PostgreSQL instance:
#PG_DATABASE_URL=postgres://postgres:replace_me_with_a_strong_password@exe-db:5432/exe
# Redis is REQUIRED. docker-compose builds REDIS_URL as
# redis://:${REDIS_PASSWORD}@redis:6379 and starts redis with
# `--requirepass ${REDIS_PASSWORD}`, so the stack will refuse to boot
# ("Set REDIS_PASSWORD") until this is set. Generate a strong value:
#   REDIS_PASSWORD=$(openssl rand -hex 32)
REDIS_PASSWORD=replace_me_with_a_strong_redis_password
# Override REDIS_URL only if pointing at an external/managed Redis. When set,
# it takes precedence and REDIS_PASSWORD is not interpolated into the URL.
#REDIS_URL=redis://redis:6379

SERVER_URL=http://localhost:3000

# Required for Exe CRM startup. The installer generates APP_SECRET automatically.
# For manual Docker Compose installs:
#   APP_SECRET=$(openssl rand -base64 32)
#   EXE_LICENSE_KEY=<your Exe CRM license key from https://askexe.com>
# APP_SECRET=
# EXE_LICENSE_KEY=

# Admin API token. Shared secret the Exe Gateway (and other trusted backend
# services) present in the Authorization: Bearer <token> header to reach the
# CRM's admin-scoped GraphQL/REST API without an interactive login. When set,
# the AdminTokenMiddleware authenticates matching requests against the first
# workspace. Leave unset to disable admin-token auth entirely.
#
# This value MUST match the gateway's CRM_API_TOKEN. Generate a strong secret:
#   EXE_CRM_ADMIN_TOKEN=$(openssl rand -hex 32)
# EXE_CRM_ADMIN_TOKEN=

# Optional GoTrue / Supabase Auth-compatible JWT bridge. Set GOTRUE_URL to
# enable external JWT validation and disable native password login.
# GOTRUE_URL=http://gotrue:9999
# GOTRUE_JWT_ISSUER=
# GOTRUE_JWT_AUDIENCE=authenticated

# Optional (strongly recommended) — Encrypted database backups
# The db-backup service runs pg_dump every 6 hours. When EXE_BACKUP_KEY is set,
# each dump is GPG-symmetrically encrypted (AES256) with this passphrase;
# if unset, backups are written UNENCRYPTED and the service logs a warning.
# Store this passphrase securely OFF the VPS — without it, encrypted dumps
# cannot be restored. Generate a strong value:
#   EXE_BACKUP_KEY=$(openssl rand -base64 32)
# EXE_BACKUP_KEY=

# Optional — Monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# EXCEPTION_HANDLER_DRIVER=SENTRY
# SENTRY_ENVIRONMENT=production

# Optional — Analytics (ClickHouse)
# CLICKHOUSE_URL=http://default:password@clickhouse:8123/twenty

# Optional — Logging
# LOGGER_DRIVER=PINO  # Default. Structured JSON in production, pretty-print in dev. Set CONSOLE for plain text.

STORAGE_TYPE=local

# STORAGE_S3_REGION=eu-west3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_PRESIGNED_URL_ENABLED=false
# STORAGE_S3_PRESIGNED_URL_BASE=
