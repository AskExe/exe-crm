TAG=latest

#PG_DATABASE_USER=postgres
#PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_url_encoded_if_needed
#PG_DATABASE_HOST=db
#PG_DATABASE_PORT=5432
#PG_DATABASE_NAME=default
# Or point directly at exe-db / another shared PostgreSQL instance:
#PG_DATABASE_URL=postgres://postgres:replace_me_with_a_strong_password@exe-db:5432/exe
#REDIS_URL=redis://redis:6379

SERVER_URL=http://localhost:3000

# Required for Exe CRM startup. The installer generates APP_SECRET automatically.
# For manual Docker Compose installs:
#   APP_SECRET=$(openssl rand -base64 32)
#   EXE_LICENSE_KEY=<your Exe CRM license key from https://askexe.com>
# APP_SECRET=
# EXE_LICENSE_KEY=

# Optional GoTrue / Supabase Auth-compatible JWT bridge. Set GOTRUE_URL to
# enable external JWT validation and disable native password login.
# GOTRUE_URL=http://gotrue:9999
# GOTRUE_JWT_ISSUER=
# GOTRUE_JWT_AUDIENCE=authenticated

STORAGE_TYPE=local

# STORAGE_S3_REGION=eu-west3
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_PRESIGNED_URL_ENABLED=false
# STORAGE_S3_PRESIGNED_URL_BASE=
