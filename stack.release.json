{
  "$schema": "https://updates.askexe.com/schemas/stack.release.schema.json",
  "schemaVersion": 1,
  "repo": "AskExe/exe-crm",
  "service": "exe-crm",
  "packageName": "twenty",
  "version": "0.9.51",
  "image": "ghcr.io/askexe/exe-crm:v0.9.51",
  "imageDigest": "sha256:73864ce14aaac06b73d67100bbf88e669fd13c7da39edd9644107037211559b7",
  "imageRef": "ghcr.io/askexe/exe-crm:v0.9.51@sha256:73864ce14aaac06b73d67100bbf88e669fd13c7da39edd9644107037211559b7",
  "imageEnv": "CRM_IMAGE_TAG",
  "stackParticipation": {
    "required": true,
    "compatibleStack": ">=0.9.0 <1.0.0",
    "health": [
      {
        "type": "http",
        "url": "http://127.0.0.1:3000/healthz"
      }
    ],
    "smokeTests": [
      {
        "name": "container health",
        "command": "curl --fail http://127.0.0.1:3000/healthz"
      },
      {
        "name": "worker boot",
        "command": "docker inspect exe-crm-worker --format '{{.State.Status}}'"
      }
    ],
    "migrations": {
      "note": "Handled by the image entrypoint — no external command needed.",
      "rollback": "Restore previous CRM_IMAGE_TAG and database backup if migration is non-additive. CRM migrations must be reviewed before stack manifest publication."
    },
    "config": {
      "envExample": "packages/twenty-docker/.env.example",
      "requiredEnv": [
        "CRM_IMAGE_TAG",
        "SERVER_URL",
        "APP_SECRET",
        "PG_DATABASE_URL",
        "REDIS_URL"
      ]
    },
    "breakingChanges": [],
    "dataSovereignty": "CRM customer/deal/contact data stays in the customer VPS Postgres/ClickHouse volumes. Updates must not reset local storage or branding config.",
    "releaseLine": "v0.9 private/customer pilot; v1.0 is public-beta stable."
  },
  "sourceVersion": "0.9.51"
}
